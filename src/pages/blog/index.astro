---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE, href } from '../../site';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title={`Insights | ${SITE.name}`} description="Articles on B2B marketing, SEO and generative engine optimisation from the Harbourline Digital team.">
  <h1>Insights</h1>
  <ul>
    {posts.map((p) => <li><a href={href(`/blog/${p.id}/`)}>{p.data.title}</a></li>)}
  </ul>
</Layout>
