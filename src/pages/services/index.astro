---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE, href } from '../../site';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="SEO and B2B Web Dev in Singapore" description="Need SEO, GEO or B2B web development in Singapore? Harbourline Digital can help. Talk to our team.">
  <h1>Services</h1>
  <ul>
    {services.map((s) => <li><a href={href(`/services/${s.id}/`)}>{s.data.title}</a> — {s.data.description}</li>)}
  </ul>
</Layout>
