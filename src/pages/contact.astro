---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../site';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "https://cleo-astro-demo-site.vercel.app/contact/#ContactPage",
  "name": "Contact | Harbourline Digital",
  "url": "https://cleo-astro-demo-site.vercel.app/contact/",
  "mainEntity": {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "https://cleo-astro-demo-site.vercel.app/#localbusiness",
    "name": "Harbourline Digital Pte Ltd",
    "url": "https://cleo-astro-demo-site.vercel.app/",
    "telephone": "+6560000000",
    "email": "hello@example.com",
    "address": {
      "@context": "https://schema.org",
      "@type": "PostalAddress",
      "streetAddress": "21 Harbour Road, #05-01",
      "addressLocality": "Singapore",
      "postalCode": "049315",
      "addressCountry": "SG"
    },
    "sameAs": [
      "https://www.linkedin.com/company/example-harbourline",
      "https://x.com/example_harbourline"
    ]
  }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@context": "https://schema.org",
      "@type": "ListItem",
      "position": 1,
      "name": "Harbourline Digital",
      "item": "https://cleo-astro-demo-site.vercel.app/"
    },
    {
      "@context": "https://schema.org",
      "@type": "ListItem",
      "position": 2,
      "name": "Contact",
      "item": "https://cleo-astro-demo-site.vercel.app/contact/"
    }
  ]
};
---
<Layout title="Contact B2B Marketing in Singapore" description="Looking for B2B marketing in Singapore? Harbourline Digital helps with SEO and GEO. Contact us now." jsonLd={[breadcrumbJsonLd]}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  <h1>Contact us</h1>
  <address>
    {SITE.legalName}<br />
    21 Harbour Road, #05-01<br />
    Singapore 049315<br />
    <a href="tel:+6560000000">+65 6000 0000</a> · <a href="mailto:hello@example.com">hello@example.com</a>
  </address>
</Layout>
