---
import { SITE, href } from '../site';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, ogType = 'website', jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL(import.meta.env.BASE_URL, Astro.site).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${home}#organization`,
  name: SITE.name,
  legalName: SITE.legalName,
  url: home,
  sameAs: SITE.sameAs,
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${home}#website`,
  name: SITE.name,
  url: home,
  publisher: { '@id': `${home}#organization` },
};
const graph = [organization, website, ...jsonLd];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    {graph.map((node) => <script type="application/ld+json" set:html={JSON.stringify(node)} />)}
  </head>
  <body>
    <header>
      <nav>
        <a href={href('/')}>{SITE.name}</a>
        <a href={href('/services/')}>Services</a>
        <a href={href('/blog/')}>Insights</a>
        <a href={href('/about/')}>About</a>
        <a href={href('/contact/')}>Contact</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {SITE.legalName}. Sandbox site for CLEO code-channel demos.</p>
    </footer>
  </body>
</html>
